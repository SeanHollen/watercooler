#!/usr/bin/env python3
"""tg-send — send photos or files from a ccgram agent session to Telegram.

  tg-send photo.jpg                        # to the calling session's OWN topic
  tg-send --caption "scores" a.jpg b.jpg   # album (2-10 per group; more = several albums)
  tg-send --general report.pdf             # to the shared General topic
  tg-send --topic 1732 chart.png           # an explicit forum topic id
  tg-send --document big.jpg               # force document (uncompressed, keeps full res)
  tg-send --resolve                        # print the topic that would be used, send nothing

Per-file captions: if <file>.caption.txt exists it is used as that file's caption
(the --caption flag applies to the first file otherwise). Captions are cut to 1024 chars.
Images (.jpg .jpeg .png .webp) <= 10 MB go as photos (Telegram recompresses them);
anything else goes as a document (<= 50 MB).

Token and group come from ~/.ccgram/.env (TELEGRAM_BOT_TOKEN, CCGRAM_GROUP_ID); the
own-topic lookup matches the calling tmux window's id against thread_bindings in
~/.ccgram/state.json (override the dir with WATERCOOLER_DIR). Sending uses the Bot API
directly over HTTPS, so it never conflicts with ccgram's getUpdates polling.
Exit 0 on success, 1 on a Telegram/API error, 2 on usage or topic-resolution error.
The token is never printed.
"""
import argparse, json, mimetypes, os, subprocess, sys, time

WC_DIR = os.environ.get("WATERCOOLER_DIR", os.path.expanduser("~/.ccgram"))
PHOTO_EXT = {".jpg", ".jpeg", ".png", ".webp"}
PHOTO_MAX = 10 * 1024 * 1024
DOC_MAX = 50 * 1024 * 1024
CAPTION_MAX = 1024


def read_env():
    vals = {}
    try:
        with open(os.path.join(WC_DIR, ".env")) as f:
            for line in f:
                line = line.strip()
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    vals[k.strip()] = v.strip().strip('"').strip("'")
    except OSError as e:
        die(2, f"cannot read {WC_DIR}/.env: {e}")
    for k in ("TELEGRAM_BOT_TOKEN", "CCGRAM_GROUP_ID"):
        if not vals.get(k):
            die(2, f"{k} missing from {WC_DIR}/.env")
    return vals


def die(code, msg):
    print(f"tg-send: {msg}", file=sys.stderr)
    sys.exit(code)


def own_topic():
    """Thread id of the Telegram topic bound to the calling tmux window, or None."""
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return None
    try:
        wid = subprocess.run(["tmux", "display-message", "-p", "-t", pane, "#{window_id}"],
                             capture_output=True, text=True, timeout=5).stdout.strip()
        state = json.load(open(os.path.join(WC_DIR, "state.json")))
    except Exception:
        return None
    for _user, bindings in state.get("thread_bindings", {}).items():
        for thread, window in bindings.items():
            if window == wid:
                return int(thread)
    return None


def api(token, method, strings, files):
    args = ["curl", "-sS", "-m", "300", "-X", "POST", f"https://api.telegram.org/bot{token}/{method}"]
    for k, v in strings:
        args += ["--form-string", f"{k}={v}"]          # literal, so a leading '@' or '<' is safe
    for k, path in files:
        args += ["-F", f"{k}=@{path}"]
    for attempt in (1, 2):
        p = subprocess.run(args, capture_output=True, text=True)
        try:
            r = json.loads(p.stdout)
        except ValueError:
            r = {"ok": False, "description": f"curl failed: {(p.stderr or p.stdout).strip()[:300]}"}
        # Telegram flood control: wait the advertised time and retry once.
        if not r.get("ok") and r.get("error_code") == 429 and attempt == 1:
            time.sleep(int(r.get("parameters", {}).get("retry_after", 5)) + 1)
            continue
        return r
    return r


def caption_for(path, fallback):
    side = path + ".caption.txt"
    if os.path.exists(side):
        return open(side, encoding="utf-8").read().strip()[:CAPTION_MAX]
    return (fallback or "")[:CAPTION_MAX]


def kind(path, force_doc):
    size = os.path.getsize(path)
    if size > DOC_MAX:
        die(2, f"{path} is {size // 1048576} MB; Bot API uploads are capped at 50 MB")
    ext = os.path.splitext(path)[1].lower()
    if force_doc or ext not in PHOTO_EXT or size > PHOTO_MAX:
        return "document"
    return "photo"


def main():
    ap = argparse.ArgumentParser(add_help=True, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("files", nargs="*")
    ap.add_argument("--caption", default=None)
    ap.add_argument("--topic", type=int, default=None, help="forum topic (message_thread_id)")
    ap.add_argument("--general", action="store_true", help="post to the shared General topic")
    ap.add_argument("--document", action="store_true", help="send everything as documents")
    ap.add_argument("--resolve", action="store_true", help="print the resolved target and exit")
    a = ap.parse_args()

    env = read_env()
    if a.general:
        topic = None
    elif a.topic is not None:
        topic = a.topic
    else:
        topic = own_topic()
        if topic is None:
            die(2, "not inside a ccgram-bound tmux window; pass --topic <id> or --general")
    if a.resolve:
        print(f"chat_id={env['CCGRAM_GROUP_ID']} topic={'General' if topic is None else topic}")
        return
    if not a.files:
        die(2, "no files given")
    for f in a.files:
        if not os.path.isfile(f):
            die(2, f"no such file: {f}")

    base = [("chat_id", env["CCGRAM_GROUP_ID"])]
    if topic is not None:
        base.append(("message_thread_id", str(topic)))
    token = env["TELEGRAM_BOT_TOKEN"]
    where = "General" if topic is None else f"topic {topic}"
    failures = 0

    # Documents always go one by one; photos go as albums of up to 10.
    photos = [f for f in a.files if kind(f, a.document) == "photo"]
    docs = [f for f in a.files if kind(f, a.document) == "document"]

    if len(photos) == 1:
        f = photos[0]
        r = api(token, "sendPhoto", base + [("caption", caption_for(f, a.caption))], [("photo", f)])
        ok = r.get("ok"); failures += not ok
        print(f"{'sent' if ok else 'FAILED'} photo {os.path.basename(f)} -> {where}" + ("" if ok else f": {r.get('description')}"))
    elif photos:
        for i in range(0, len(photos), 10):
            chunk = photos[i:i + 10]
            media = []
            files = []
            for j, f in enumerate(chunk):
                key = f"file{j}"
                item = {"type": "photo", "media": f"attach://{key}"}
                cap = caption_for(f, a.caption if (j == 0 and i == 0) else None)
                if cap:
                    item["caption"] = cap
                media.append(item)
                files.append((key, f))
            if i:
                time.sleep(1.5)   # several albums back to back trip flood control otherwise
            r = api(token, "sendMediaGroup", base + [("media", json.dumps(media))], files)
            ok = r.get("ok"); failures += not ok
            print(f"{'sent' if ok else 'FAILED'} album of {len(chunk)} -> {where}" + ("" if ok else f": {r.get('description')}"))
    for f in docs:
        r = api(token, "sendDocument", base + [("caption", caption_for(f, a.caption))], [("document", f)])
        ok = r.get("ok"); failures += not ok
        print(f"{'sent' if ok else 'FAILED'} document {os.path.basename(f)} -> {where}" + ("" if ok else f": {r.get('description')}"))
    sys.exit(1 if failures else 0)


if __name__ == "__main__":
    main()
