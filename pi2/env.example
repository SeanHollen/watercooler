# PI2 — Zamua telegram-topics proxy config.
# Install to ~/.claude/channels/telegram-topics/.env (chmod 600). Never commit the token.
TELEGRAM_BOT_TOKEN=<from-BotFather, /setprivacy Disable>
TELEGRAM_GROUP_CHAT_ID=<the forum supergroup id, e.g. -100...>
TELEGRAM_TOPICS_SPAWN_DIR=/home/seanhollen/pi2
TELEGRAM_PROXY_PORT=8790
TELEGRAM_TOPICS_MODEL=fable
TELEGRAM_TOPICS_ADMIN_USER_ID=5523966740
TELEGRAM_TOPICS_SECRETS_USER_ID=5523966740
TELEGRAM_TOPICS_VOICE_TRANSCRIBE=false
