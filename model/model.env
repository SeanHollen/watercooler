# Model + reasoning for ccgram-spawned Claude Code sessions.
# ANTHROPIC_MODEL: default model for every spawned session.
#   2026-10-21: switched from `fable` (Claude Fable 5.1) to Claude Opus 5.5 at Sean's request.
# CLAUDE_CODE_EFFORT_LEVEL: persistent reasoning depth; "max" is the highest
#   (the always-on equivalent of typing "ultrathink" each turn).
ANTHROPIC_MODEL=claude-opus-5-5
CLAUDE_CODE_EFFORT_LEVEL=max
